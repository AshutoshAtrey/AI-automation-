
{
  "manifest_version": 3,
  "name": "Universal AI Form Assistant",
  "version": "1.0.0",
  "description": "AI assistant for website forms and questionnaires.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Universal AI Form Assistant",
    "default_popup": "popup.html"
  }
}
